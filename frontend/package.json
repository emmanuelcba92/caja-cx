{
  "name": "cirug-as",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "verify:isolation": "node scripts/verify-isolation.mjs --mode development",
    "predev": "npm run verify:isolation",
    "dev": "vite --mode development",
    "predev:host": "npm run verify:isolation",
    "dev:host": "vite --host --mode development",
    "prebuild": "npm run verify:production",
    "build": "vite build --mode production",
    "postbuild": "node scripts/verify-isolation.mjs --mode production --allow-production --dist",
    "verify:production": "node scripts/verify-isolation.mjs --mode production --allow-production",
    "prebuild:production": "npm run verify:production",
    "build:production": "vite build --mode production",
    "postbuild:production": "node scripts/verify-isolation.mjs --mode production --allow-production --dist",
    "lint": "oxlint",
    "preview": "vite preview --mode development",
    "pretest": "npm run verify:isolation",
    "test": "node --test \"tests/*.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-coat-rediseno",
    "emulators:auth": "firebase emulators:start --only auth --project demo-coat-rediseno"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/postcss": "^4.3.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.1",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0"
  }
}
