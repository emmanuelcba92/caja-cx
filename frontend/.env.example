# ============================================================
# COAT Cirugías Rediseño — Plantilla de entornos (.env.example)
#
# 1) DESARROLLO AISLADO (por defecto: npm run dev / npm run build / npm test)
#    Copiar a .env.development (ignorado por Git) y completar con los datos de coatcx:
# ============================================================
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_PROJECT_ID=coatcx
VITE_FIREBASE_API_KEY=<API_KEY_DEL_PROYECTO_COATCX>
VITE_FIREBASE_AUTH_DOMAIN=coatcx.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=coatcx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=392377174292
VITE_FIREBASE_APP_ID=1:392377174292:web:0925688b5e459c444dda01
# En modo desarrollo, Supabase y Gemini permanecen DESHABILITADOS.
#
# 2) COMPILACIÓN EXPLÍCITA DE PRODUCCIÓN (npm run build:production -> --mode production)
#    Definir únicamente en .env.production.local (ignorado por Git):
#    - VITE_ALLOW_PRODUCTION_FIREBASE=true
#    - VITE_USE_FIREBASE_EMULATOR=false
#    - VITE_FIREBASE_* del proyecto principal
#    - VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY (clave pública anon, nunca service_role)
#    - VITE_GEMINI_API_KEY (opcional)
