rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Excepción mínima para identificar únicamente al nuevo rol CONSULTA (solo lectura)
    function isConsulta() {
      return request.auth != null && (
        (
          request.auth.token.email is string &&
          exists(/databases/$(database)/documents/authorized_emails/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/authorized_emails/$(request.auth.token.email.lower())).data.get('role', '').lower() == 'consulta'
        ) ||
        (
          exists(/databases/$(database)/documents/authorized_emails/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/authorized_emails/$(request.auth.uid)).data.get('role', '').lower() == 'consulta'
        ) ||
        (
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', '').lower() == 'consulta'
        )
      );
    }

    // Colección de Auditoría (INMUTABLE)
    match /audit_logs/{logId} {
      allow read: if request.auth != null && 
        (request.auth.token.email.lower() == 'emmanuel.ag92@gmail.com' ||
         (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role.lower() in ['admin', 'superadmin', 'super_admin']));
      allow create: if request.auth != null && !isConsulta();
      allow update, delete: if false; // Bloqueo total de edición/borrado
    }

    // CAJA PROJECT RULES
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !isConsulta();
    }
  }
}
